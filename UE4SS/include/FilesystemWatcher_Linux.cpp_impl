// Linux implementation of FilesystemWatcher, mirroring FilesystemWatcher_Windows.cpp_impl: one
// non-recursive watch per directory (inotify instead of FindFirstChangeNotificationW), notifying the
// "*" watches on writes, with the same minimum duration between notifications.

#include <cerrno>
#include <chrono>
#include <cstring>
#include <poll.h>
#include <sys/inotify.h>
#include <unistd.h>

#include <DynamicOutput/DynamicOutput.hpp>
#include <Helpers/String.hpp>

namespace RC
{
    struct Data
    {
        int fd{-1};
        std::filesystem::path path{};

        ~Data()
        {
            if (fd != -1)
            {
                close(fd);
                fd = -1;
            }
        }
    };

    auto init_filesystem_watcher(FilesystemWatcher& watcher, const std::filesystem::path& path) -> void
    {
        auto data = new Data{};
        watcher.m_handle = data;
        watcher.m_handles.emplace_back(static_cast<void*>(data));
        data->path = path;
        data->fd = inotify_init1(IN_NONBLOCK | IN_CLOEXEC);
        if (data->fd == -1)
        {
            Output::send<LogLevel::Error>(STR("ERROR: inotify_init1 failed for '{}': {}\n"), ensure_str(path.string()), ensure_str(std::strerror(errno)));
            return;
        }
        // IN_CLOSE_WRITE/IN_MOVED_TO: an editor saving a script either rewrites it or replaces it.
        if (inotify_add_watch(data->fd, path.c_str(), IN_CLOSE_WRITE | IN_MODIFY | IN_CREATE | IN_MOVED_TO | IN_DELETE) == -1)
        {
            Output::send<LogLevel::Error>(STR("ERROR: inotify_add_watch failed for '{}': {}\n"), ensure_str(path.string()), ensure_str(std::strerror(errno)));
        }
    }

    FilesystemWatcher::~FilesystemWatcher()
    {
        if (m_stop_source.stop_possible())
        {
            m_stop_source.request_stop();
        }
        if (m_polling_thread.joinable())
        {
            m_polling_thread.join();
        }
        for (auto& handle : m_handles)
        {
            auto data = static_cast<Data*>(handle);
            if (data)
            {
                delete data;
            }
        }
    }

    auto FilesystemWatcher::poll(std::stop_token stop_token) -> void
    {
        std::vector<pollfd> descriptors{};
        for (const auto& handle_data_raw : m_handles)
        {
            auto handle_data = static_cast<Data*>(handle_data_raw);
            descriptors.push_back(pollfd{handle_data->fd, POLLIN, 0});
        }

        alignas(inotify_event) char buffer[4096];
        while (!stop_token.stop_requested())
        {
            if (::poll(descriptors.data(), descriptors.size(), s_polling_timeout_ms) <= 0)
            {
                continue;
            }
            for (size_t index = 0; index < descriptors.size(); ++index)
            {
                if (stop_token.stop_requested())
                {
                    return;
                }
                if (!(descriptors[index].revents & POLLIN))
                {
                    continue;
                }
                // Drain the queue: the events themselves are not used, like on Windows (the
                // notification is per directory, through the "*" watch).
                while (read(descriptors[index].fd, buffer, sizeof(buffer)) > 0)
                {
                }
                for (const auto& watch : m_watches)
                {
                    bool match_all = watch.name == "*";
                    if (match_all)
                    {
                        if (std::chrono::high_resolution_clock::now() - m_last_notification < m_min_duration_between_notifications)
                        {
                            continue;
                        }
                        const auto handle_data = static_cast<Data*>(m_handles[index]);
                        watch.notify(handle_data->path, match_all);
                        m_last_notification = std::chrono::high_resolution_clock::now();
                    }
                }
            }
        }
    }
} // namespace RC
